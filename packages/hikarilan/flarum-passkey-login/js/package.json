{
    "name": "@hikarilan/flarum-passkey-login",
    "private": true,
    "version": "0.0.0",
    "packageManager": "pnpm@11.18.0",
    "devDependencies": {
        "@flarum/prettier-config": "^1.0.0",
        "@simplewebauthn/typescript-types": "^8.3.4",
        "@types/jquery": "^3.5.10",
        "@types/mithril": "^2.0.8",
        "dayjs": "^1.10.7",
        "flarum-tsconfig": "^1.0.2",
        "flarum-webpack-config": "^2.0.0",
        "focus-trap": "^6.7.1",
        "jquery": "^3.6.0",
        "mithril": "~2.0.4",
        "prettier": "^2.5.1",
        "rimraf": "^3.0.2",
        "typescript": "^4.5.4",
        "typescript-coverage-report": "^0.6.1",
        "webpack": "^5.65.0",
        "webpack-cli": "^4.9.1"
    },
    "scripts": {
        "dev": "webpack --mode development --watch",
        "build": "webpack --mode production",
        "analyze": "cross-env ANALYZER=true pnpm run build",
        "format": "prettier --write src",
        "format-check": "prettier --check src",
        "clean-typings": "rimraf dist-typings && mkdir dist-typings",
        "build-typings": "pnpm run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && pnpm run post-build-typings",
        "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
        "check-typings": "tsc --noEmit --emitDeclarationOnly false",
        "check-typings-coverage": "typescript-coverage-report"
    },
    "prettier": "@flarum/prettier-config",
    "dependencies": {
        "@simplewebauthn/browser": "^8.3.4"
    }
}
