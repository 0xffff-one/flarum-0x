{
    "private": true,
    "name": "@flarum/core",
    "version": "0.0.0",
    "type": "module",
    "prettier": "@flarum/prettier-config",
    "dependencies": {
        "@askvortsov/rich-icu-message-formatter": "^0.2.4",
        "@ultraq/icu-message-formatter": "^0.12.0",
        "body-scroll-lock": "4.0.0-beta.0",
        "bootstrap": "^3.4.1",
        "clsx": "^1.2.1",
        "color-thief-browser": "^2.0.2",
        "dayjs": "^1.11.20",
        "focus-trap": "^6.9.4",
        "jquery": "^3.7.1",
        "jquery.hotkeys": "^0.1.0",
        "mithril": "~2.0.4",
        "nanoid": "^3.3.12",
        "punycode": "^2.3.1",
        "textarea-caret": "^3.1.0",
        "throttle-debounce": "^3.0.1"
    },
    "devDependencies": {
        "@flarum/jest-config": "^1.0.1",
        "@flarum/prettier-config": "^1.0.0",
        "@types/body-scroll-lock": "^3.1.2",
        "@types/jquery": "^3.5.34",
        "@types/mithril": "^2.2.8",
        "@types/punycode": "^2.1.4",
        "@types/textarea-caret": "^3.0.4",
        "@types/ua-parser-js": "^0.7.39",
        "bundlewatch": "^0.3.3",
        "cross-env": "^7.0.3",
        "expose-loader": "^3.1.0",
        "flarum-tsconfig": "^1.0.3",
        "flarum-webpack-config": "^2.0.2",
        "prettier": "^2.8.8",
        "typescript": "^4.9.5",
        "typescript-coverage-report": "^0.6.4",
        "webpack": "^5.106.2",
        "webpack-cli": "^4.10.0",
        "webpack-merge": "^5.10.0"
    },
    "scripts": {
        "dev": "webpack --mode development --watch",
        "build": "webpack --mode production",
        "build-0x": "webpack --mode production && touch ../../../../js/dist-core && rm -r ../../../../js/dist-core && cp -r dist ../../../../js/dist-core",
        "analyze": "cross-env ANALYZER=true yarn run build",
        "format": "prettier --write src",
        "format-check": "prettier --check src",
        "clean-typings": "npx rimraf dist-typings && mkdir dist-typings",
        "build-typings": "yarn run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && yarn run post-build-typings",
        "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
        "check-typings": "tsc --noEmit --emitDeclarationOnly false",
        "check-typings-coverage": "typescript-coverage-report",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)"
    },
    "pnpm": {
        "overrides": {
            "@babel/helpers": "7.29.4",
            "@babel/plugin-transform-modules-systemjs": "7.29.4",
            "@babel/runtime": "7.29.4",
            "@tootallnate/once": "3.0.1",
            "axios": "0.31.1",
            "brace-expansion@>=1.0.0 <2.0.0": "1.1.12",
            "brace-expansion@>=2.0.0 <3.0.0": "2.0.2",
            "follow-redirects": "1.15.12",
            "form-data": "4.0.4",
            "lodash": "4.18.1",
            "minimatch@>=3.0.0 <4.0.0": "3.1.5",
            "minimatch@>=5.0.0 <6.0.0": "5.1.9",
            "minimatch@>=10.0.0 <11.0.0": "10.2.5",
            "picomatch": "2.3.2",
            "ws": "8.20.1"
        }
    }
}
